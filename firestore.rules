rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ヘルパー関数
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(data) {
      return data.ownerId == request.auth.uid || data.ownerId == request.resource.data.ownerId;
    }

    function isSafeTimestamp(value) {
      return value is timestamp || value is int || value is float;
    }

    function isValidGame(data) {
      return data.keys().hasOnly([
               'roomId',
               'boardId',
               'status',
               'players',
               'playerOrder',
               'currentTurnIndex',
               'logs',
               'pendingInteraction',
               'lastAction',
               'createdAt',
               'updatedAt'
             ]) &&
             data.roomId is string &&
             data.boardId is string &&
             data.status in ['waiting', 'playing', 'finished'] &&
             data.players is map &&
             data.playerOrder is list &&
             data.playerOrder.size() <= 12 &&
             data.currentTurnIndex is int &&
             data.logs is list &&
             data.logs.size() <= 80 &&
             isSafeTimestamp(data.createdAt) &&
             isSafeTimestamp(data.updatedAt);
    }

    // Boards (盤面データ)
    match /boards/{boardId} {
      // 読み取り：公開されている、または自分が所有者（または共同編集URLを知っている）
      allow read: if resource.data.isPublic == true || 
                     (isSignedIn() && resource.data.ownerId == request.auth.uid) ||
                     request.query.limit <= 100; // リスト表示用

      // 作成：基本バリデーション
      allow create: if request.resource.data.name is string && 
                       request.resource.data.name.size() >= 1 && 
                       request.resource.data.name.size() <= 100;

      // 更新：所有者、または共同編集が許可されている場合
      allow update: if (resource.data.ownerId == request.auth.uid) || 
                       (resource.data.allowPublicEdit == true) ||
                       // 通報やプレイ回数のインクリメントのみを許可する特別なケース
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount', 'playCount', 'updatedAt']));

      // 削除：所有者のみ
      allow delete: if resource.data.ownerId == request.auth.uid;

      // リビジョン（サブコレクション）
      match /revisions/{revId} {
        allow read, write: if get(/databases/$(database)/documents/boards/$(boardId)).data.ownerId == request.auth.uid;
      }
    }

    // Games / Rooms (プレイデータ)
    match /games/{gameId} {
      allow read: if true;
      allow create: if isValidGame(request.resource.data) &&
                      request.resource.data.playerOrder.size() >= 1;
      allow update: if isValidGame(request.resource.data) &&
                      // ターン遷移のバリデーション（簡易版）
                      (request.resource.data.currentTurnIndex == resource.data.currentTurnIndex ||
                       request.resource.data.currentTurnIndex == (resource.data.currentTurnIndex + 1) % request.resource.data.playerOrder.size() ||
                       request.resource.data.status == 'waiting') && // リセット時は許容
                      request.resource.data.size() < 1048576;
      allow delete: if false;
    }
  }
}
